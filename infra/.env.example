# Copier ce fichier en .env puis changer le mot de passe.
# SQL Server exige : 8 caractères minimum, majuscules, minuscules, chiffres et symboles.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
# 14330 plutôt que 1433, pour ne pas entrer en conflit avec un SQL Server installé sur ton PC.
MSSQL_PORT=14330
# Clé partagée entre l'API .NET et le service IA (32 caractères minimum).
KK_AI_INTERNAL_API_KEY=change-me-with-at-least-32-random-characters
AI_SERVICE_PORT=8001
